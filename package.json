{
  "name": "liv-certification-platform",
  "version": "1.0.0",
  "description": "LIV LLC \u2014 training accreditation, certificate issuance (PDF+QR) and public verification",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "reset-admin": "node scripts/reset-admin.js",
    "purge-demo": "node scripts/purge-demo.js",
    "check:standards": "NODE_USE_ENV_PROXY=1 node scripts/check-standards.js",
    "check:sources": "NODE_USE_ENV_PROXY=1 node scripts/check-sources.js",
    "review-packs": "node scripts/review-packs.js",
    "test": "node tests/e2e.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "engine:review-file": "node engines/cli.js review-file",
    "engine:review-queue": "node engines/cli.js review-queue",
    "engine:usage": "node engines/cli.js usage",
    "brand": "node scripts/brand-seal.js && node scripts/brand-png.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "marked": "^18.0.14",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
