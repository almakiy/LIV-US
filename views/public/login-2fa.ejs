<%- include('../partials/auth-top') %>
      <h1>Two-factor sign-in</h1>
      <p class="muted">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form method="post" action="/login/2fa">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="f-code">Code</label><input id="f-code" type="text" name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus maxlength="12"></div>
        <button class="btn lg" style="width:100%">Verify</button>
      </form>
      <p class="small muted"><a href="/login">Start over</a></p>
<%- include('../partials/auth-bottom') %>
