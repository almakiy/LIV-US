<%- include('../partials/head') %>
<article class="section"><div class="container" style="max-width:780px">
  <% if (preview) { %><div class="alert warn">Preview — this is how the article will look. Status: <strong><%= a.status %></strong>.</div><% } %>
  <p class="small"><a href="/knowledge">Knowledge Hub</a> › <a href="/knowledge?category=<%= a.category %>"><%= CATEGORIES[a.category] %></a></p>
  <span class="badge b-active"><%= KINDS[a.kind] %></span>
  <h1 style="margin:10px 0 6px"><%= a.title %></h1>
  <p class="muted"><%= a.summary %></p>
  <p class="small muted"><%= a.author_name || brand %> · <%= a.published_at ? longDate(a.published_at) : 'Draft' %> · <%= minutes %> min read</p>
  <div class="prose"><%- html %></div>
  <% if (a.tags && a.tags.length) { %><p class="small mt"><% a.tags.forEach(t => { %><a class="badge b-pending" href="/knowledge?q=<%= encodeURIComponent(t) %>" style="text-decoration:none">#<%= t %></a> <% }) %></p><% } %>
  <% if ((a.sources && a.sources.length) || (a.standards && a.standards.length)) { %><section class="mt"><h3>Sources and standards</h3>
    <% if (a.standards && a.standards.length) { %><p class="small"><strong>Standards referenced:</strong> <%= a.standards.join(' · ') %></p><% } %>
    <% if (a.sources && a.sources.length) { %><ol class="small"><% a.sources.forEach(s => { %><li><a href="<%= s.url %>" target="_blank" rel="noopener nofollow"><%= s.title %></a><%= s.publisher ? ' — ' + s.publisher : '' %></li><% }) %></ol><% } %></section><% } %>
  <% if (a.reviewed_by) { %><p class="small muted mt">Reviewed by <strong><%= a.reviewed_by %></strong><%= a.reviewed_at ? ' on ' + longDate(a.reviewed_at) : '' %> · Version <%= a.version || 1 %><%= a.next_review_at ? ' · Next review ' + longDate(a.next_review_at) : '' %><%= a.ai_assisted ? ' · Prepared with AI assistance and reviewed by a human subject-matter reviewer.' : '' %></p><% } %>
  <p class="small muted mt">Educational content only; not legal, engineering or professional advice. <%= brand %> does not imply endorsement by any standards body or government agency.</p>
  <% if (related && related.length) { %><h3 class="mt">More in <%= CATEGORIES[a.category] %></h3><ul><% related.forEach(x => { %><li><a href="/knowledge/<%= x.slug %>"><%= x.title %></a> <span class="muted small">(<%= KINDS[x.kind] %>)</span></li><% }) %></ul><% } %>
</div></article>
<%- include('../partials/foot') %>
