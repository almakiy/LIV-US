<%- include('../partials/head') %>
<%
const R = out.result;
const banner = {
  valid: ['✓', 'VALID', 'This credential is authentic and currently valid.'],
  revoked: ['✕', 'REVOKED', 'This credential has been revoked and is no longer valid.'],
  tampered: ['✕', 'INVALID', 'The record or QR code failed the integrity check. Do not rely on this credential.'],
  not_found: ['?', 'NOT FOUND', 'No credential matches these details. Check the ID and try again.'],
  invalid_format: ['?', 'NOT FOUND', 'That Credential ID is not in a valid format.'],
}[R];
%>
<div class="container verify-wrap">
  <div class="vhead"><%- include('../partials/logo') %><div><h1 class="mb0" style="font-size:1.4rem">Official Verification Portal</h1><div class="muted small">Checked <%= usDateTime(new Date()) %></div></div></div>
  <div class="status-banner sb-<%= R %>">
    <div class="icon"><%= banner[0] %></div>
    <div><h2><%= banner[1] %></h2><p><%= banner[2] %></p></div>
  </div>
  <% if (c && R !== 'tampered') { %>
  <div class="card details">
    <dl>
      <% const RT = (recordTypes[c.record_type] || recordTypes.training_completion); %>
      <dt>Record type</dt><dd><%= RT.label %> <span class="muted small">(<%= RT.disclosure %>)</span></dd>
      <dt>Credential holder</dt><dd><%= c.recipient_first_name %> <%= c.recipient_last_name %></dd>
      <dt>Course</dt><dd><%= c.course_name %></dd>
      <dt>Completion date</dt><dd><%= longDate(c.completion_date) %></dd>
      <dt>Issue date</dt><dd><%= longDate(c.issue_date) %></dd>
      <dt>Credential ID</dt><dd class="mono"><%= c.cert_number %></dd>
      <dt>Education provider</dt><dd><div class="issuer"><% if (c.logo_path) { %><img src="/logo/<%= c.platform_id %>" alt=""><% } %><span><%= c.company_name %></span>
        <% if (c.accreditation_status !== 'active') { %><span class="badge b-<%= c.accreditation_status %>">Partner <%= c.accreditation_status %></span><% } else { %><span class="badge b-active">LIV Authorized Education Partner</span><% } %></div></dd>
      <% if (c.scope_title) { %><dt>Authorized scope</dt><dd><%= c.scope_title %><% if (c.scheme_name) { %> <span class="muted small">(<%= c.scheme_name %> family)</span><% } %><% if (c.scope_status !== 'active') { %> <span class="badge b-suspended">scope <%= c.scope_status %></span><% } %></dd><% } %>
      <% if (R === 'revoked') { %><dt>Revoked on</dt><dd><%= longDate(new Date(c.revoked_at)) %></dd><% } %>
    </dl>
    <div class="actions">
      <% if (R !== 'revoked' && token) { %><a class="btn" href="/verify/<%= c.cert_number %>/pdf?t=<%= token %>">Download original PDF</a><% } %>
      <% if (linkedin) { %><a class="btn secondary" href="<%= linkedin %>" target="_blank" rel="noopener">Add to LinkedIn profile</a><% } %>
      <button type="button" class="btn secondary" data-copy="<%= shareUrl %>">Copy verification link</button>
    </div>
  </div>
  <% } %>
  <p class="small muted mt">Verification reflects <%= brand %> records at the time of the check. Questions? <a href="/contact">Contact support</a>. <a href="/verify">Verify another credential</a></p>
</div>
<%- include('../partials/foot') %>
