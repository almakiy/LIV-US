<%- include('../partials/head') %>
<section class="section"><div class="container" style="max-width:880px">
  <p class="small"><a href="/credentials">Credentials</a> · <%= s.name %></p>
  <span class="badge b-pending"><%= s.status.toUpperCase() %></span>
  <h1 class="mt"><%= s.name %></h1>
  <p class="muted" style="font-size:1.08rem"><%= s.tagline %></p>
  <p><%= s.summary %></p>
  <h2 class="mt">Potential competency areas</h2>
  <p class="small muted">Indicative only. The final competency framework will come from a formal Job Task Analysis.</p>
  <ul><% s.focus.forEach(f => { %><li><%= f %></li><% }) %></ul>
  <h2 class="mt">Positioning</h2>
  <p><%= s.positioning %></p>
  <h2 class="mt">Not yet defined</h2>
  <p>The following will be set through a formal Job Task Analysis and credential scheme design process, and published before any assessment is offered:</p>
  <ul><% s.pending.forEach(f => { %><li><%= f %></li><% }) %></ul>
  <div class="alert info small">This credential family is in development. No assessment is offered yet and no qualification under it has been issued. Details may change before publication. It is not affiliated with, endorsed by or equivalent to any other body's qualification.</div>
  <p class="mt"><a class="btn" href="/contact">Register interest</a></p>
</div></section>
<%- include('../partials/foot') %>
