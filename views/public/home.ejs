<%- include('../partials/head') %>
<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow"><%= brandLong %></span>
      <h1><%= brandLine %></h1>
      <p><%= brand %> is a U.S.-based private professional credentialing and verification organization. We define credential schemes, authorize education partners to deliver within an approved scope, and keep the authoritative record that anyone can check online.</p>
      <form class="hero-search" action="/verify" method="get">
        <input name="id" placeholder="Enter Credential ID, e.g. LIV-2026-7KQ4M9XZ" aria-label="Credential ID" autocomplete="off" required>
        <button class="btn gold lg">Verify Credential</button>
      </form>
      <div class="actions"><a class="btn ghost" href="/credentials">Explore credentials →</a> <a class="btn ghost" href="/partners">Become an Authorized Education Partner →</a></div>
      <div class="trust"><span>Tamper-evident records</span><span>Instant QR verification</span><span>Real-time revocation</span><span>Partner surveillance</span></div>
    </div>
    <div class="hero-seal"><img src="/static/brand/liv-seal-reverse.svg" alt="<%= brand %> seal" width="340" height="340"></div>
  </div>
</section>
<section class="band">
  <div class="container band-grid">
    <div><strong>Defined</strong><span><%= brand %> owns its credential schemes: competency frameworks, assessment requirements and credential rules.</span></div>
    <div><strong>Verifiable</strong><span>Every credential carries a unique ID and a cryptographically signed QR code.</span></div>
    <div><strong>Transparent</strong><span>Revocation and partner authorization status are shown on every verification.</span></div>
  </div>
</section>
<section class="section white">
  <div class="container">
    <h2 class="center">How <%= brand %> credentials work</h2>
    <p class="center muted">One lifecycle, one authoritative record.</p>
    <div class="grid g4 mt">
      <div class="card"><div class="step-n">1</div><h3>Credential scheme</h3><p class="muted small"><%= brand %> defines the competencies, the assessment and the rules for each credential.</p></div>
      <div class="card"><div class="step-n">2</div><h3>Authorized education</h3><p class="muted small">Authorized Education Partners deliver education within the scope <%= brand %> has approved.</p></div>
      <div class="card"><div class="step-n">3</div><h3>Assessment and decision</h3><p class="muted small">Where a scheme requires it, the candidate completes the assessment and <%= brand %> records the credential decision.</p></div>
      <div class="card"><div class="step-n">4</div><h3>Public verification</h3><p class="muted small">Employers scan the QR code or enter the ID to see live status: valid or revoked.</p></div>
    </div>
  </div>
</section>
<section class="section">
  <div class="container grid g2">
    <div class="card"><h3>For employers &amp; HR</h3><p class="muted">Confirm a candidate's or contractor's credential in seconds, without calls or emails to the education partner.</p><a href="/verify">Verify a credential →</a></div>
    <div class="card"><h3>For education partners</h3><p class="muted">Deliver education within an authorized scope and give your learners records that employers can verify instantly.</p><a href="/partners">Explore the Education Partner Program →</a></div>
  </div>
</section>
<section class="section"><div class="container"><p class="small muted center" style="max-width:820px;margin:0 auto"><%= brand %> is a private organization operated by <%= legalEntity %>. Its credentials and partner authorizations are private and voluntary; they are not government approvals and do not guarantee the competence or performance of any individual.</p></div></section>
<%- include('../partials/foot') %>
