<%- include('../partials/auth-top') %>
      <h1>Reset your password</h1>
      <% if (sent) { %><div class="alert success" role="status">If an individual account uses this address, a reset link is on its way. It works for one hour.</div>
      <% } else { %>
      <p class="muted">For individual accounts. Training providers and <%= brand %> staff: contact <%= brand %> to reset your password.</p>
      <form method="post" action="/password/forgot">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="r-email">Email address</label><input id="r-email" type="email" name="email" autocomplete="email" required></div>
        <button class="btn lg" style="width:100%">Send reset link</button>
      </form><% } %>
      <p class="small muted mt"><a href="/login">Back to sign in</a></p>
<%- include('../partials/auth-bottom') %>
