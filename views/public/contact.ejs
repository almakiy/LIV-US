<%- include('../partials/head') %>
<div class="container" style="max-width:640px;margin:40px auto">
  <h1>Contact &amp; support</h1>
  <p class="muted">General questions, training provider enquiries, credential questions or technical support. We usually reply within one business day.</p>
  <% if (sent) { %><div class="alert success">Thank you. Your message has been received.</div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form class="card" method="post" action="/contact">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><div class="field"><label for="f-name">Name</label><input id="f-name" name="name" value="<%= form.name || '' %>" required></div>
    <div class="field"><label for="f-email">Email</label><input id="f-email" type="email" name="email" value="<%= form.email || '' %>" required></div></div>
    <div class="field"><label for="f-topic">Topic</label><select id="f-topic" name="topic">
      <% [['general','General inquiry'],['accreditation','Training provider program'],['technical','Technical support'],['verification','Verification issue'],['complaint','Complaint'],['appeal','Appeal of a decision']].forEach(([v,l]) => { %><option value="<%= v %>" <%= form.topic === v ? 'selected' : '' %>><%= l %></option><% }) %>
    </select></div>
    <div class="field"><label for="f-message">Message</label><textarea id="f-message" name="message" rows="6" required><%= form.message || '' %></textarea></div>
    <button class="btn">Send message</button>
  </form>
</div>
<%- include('../partials/foot') %>
