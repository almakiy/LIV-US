<%- include('head') %>
<div class="shell">
  <aside class="side">
  <% if (user.role === 'super_admin' && !user.actingAs) { %>
    <div class="sec">LIV Administration</div>
    <a href="/admin" class="<%= path === '/admin' || path === '/admin/' ? 'on' : '' %>">Overview</a>
    <a href="/admin/platforms" class="<%= path.startsWith('/admin/platforms') ? 'on' : '' %>">Training platforms</a>
    <a href="/admin/certificates" class="<%= path.startsWith('/admin/certificates') ? 'on' : '' %>">All certificates</a>
    <a href="/admin/audit" class="<%= path.startsWith('/admin/audit') ? 'on' : '' %>">Audit log</a>
    <a href="/admin/content" class="<%= path.startsWith('/admin/content') ? 'on' : '' %>">Content</a>
    <a href="/admin/qms" class="<%= path.startsWith('/admin/qms') ? 'on' : '' %>">Compliance</a>
    <a href="/admin/service-keys" class="<%= path.startsWith('/admin/service-keys') ? 'on' : '' %>">Service keys</a>
    <a href="/admin/messages" class="<%= path.startsWith('/admin/messages') ? 'on' : '' %>">Messages</a>
  <% } else { %>
    <div class="sec"><%= user.company_name %></div>
    <a href="/portal" class="<%= path === '/portal' || path === '/portal/' ? 'on' : '' %>">Dashboard</a>
    <a href="/portal/issue" class="<%= path.startsWith('/portal/issue') ? 'on' : '' %>">Issuance Center</a>
    <a href="/portal/certificates" class="<%= path.startsWith('/portal/certificates') || path.startsWith('/portal/batches') ? 'on' : '' %>">History &amp; Records</a>
    <a href="/portal/templates" class="<%= path.startsWith('/portal/templates') ? 'on' : '' %>">Templates</a>
    <a href="/portal/settings" class="<%= path.startsWith('/portal/settings') ? 'on' : '' %>">Settings &amp; API keys</a>
    <a href="/portal/api-docs" class="<%= path.startsWith('/portal/api-docs') ? 'on' : '' %>">API docs</a>
  <% } %>
  </aside>
  <main class="main">
    <% if (user.role === 'platform_admin' && user.accreditation_status !== 'active') { %>
      <div class="alert <%= user.accreditation_status === 'suspended' ? 'error' : 'warn' %>">
        Accreditation status: <strong><%= user.accreditation_status %></strong>.
        <%= user.accreditation_status === 'pending' ? 'Certificate issuance unlocks once LIV approves your application.' : 'Issuance is disabled. Contact LIV support.' %>
      </div>
    <% } %>
    <% if (user.actingAs) { %>
      <div class="alert warn">Acting on behalf of <strong><%= user.company_name %></strong>. Every action is recorded under your admin account.
        <form method="post" action="/admin-exit" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary">Return to admin</button></form></div>
    <% } %>
    <%- include('flash') %>
