<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · <%= brand %> | <%= brandLong %></title>
<meta name="description" content="<%= brand %> (<%= brandLong %>) is an independent US accreditation body for training providers, with official certificate verification.">
<link rel="icon" type="image/svg+xml" href="/static/brand/favicon.svg">
<link rel="icon" type="image/png" href="/static/brand/favicon.png">
<meta name="theme-color" content="#0B1F3A">
<link rel="stylesheet" href="/static/style.css">
<script src="/static/app.js" defer></script>
</head>
<body>
<div class="utility"><div class="container"><span>Independent Accreditation &amp; Credential Verification · United States</span><a href="/verify">Verify a Certificate</a></div></div>
<header class="topbar">
  <div class="container">
    <a class="brand" href="/" aria-label="<%= brand %> — <%= brandLong %>, home"><img src="/static/brand/liv-seal-reverse.svg" alt="" width="52" height="52"><span class="wm"><%= brand %><small><%= brandLong %></small></span></a>
    <nav class="nav">
      <a href="/verify" class="<%= path.startsWith('/verify') ? 'on' : '' %>">Verify</a>
      <a href="/accreditation" class="<%= path === '/accreditation' ? 'on' : '' %>">Accreditation</a>
      <a href="/about" class="<%= path === '/about' ? 'on' : '' %>">About</a>
      <a href="/contact" class="<%= path === '/contact' ? 'on' : '' %>">Contact</a>
      <% if (user) { %>
        <a href="<%= user.role === 'super_admin' ? '/admin' : '/portal' %>" class="<%= path.startsWith('/portal') || path.startsWith('/admin') ? 'on' : '' %>"><%= user.role === 'super_admin' ? 'Admin' : 'Portal' %></a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Log out</button></form>
      <% } else { %>
        <a href="/login" class="<%= path === '/login' ? 'on' : '' %>">Provider login</a>
      <% } %>
    </nav>
  </div>
</header>
