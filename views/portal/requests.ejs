<%- include('../partials/app-start') %>
<div class="page-head"><h1>Training requests</h1></div>
<p class="small muted">Organizations ask LIV for a training quote. LIV sends each request at the same time to up to <%= MAX %> Authorized Training Providers with the requested scope, choosing those that received the fewest requests in the last 90 days. Your level gives no priority. Reply to the organization directly; LIV takes no part in the price or the contract.</p>
<% if (!rows.length) { %><p class="muted">No requests yet.</p><% } else { %><div class="table-wrap" tabindex="0"><table><tr><th>Received</th><th>Organization</th><th>Scope</th><th>Details</th><th>Contact</th></tr>
<% rows.forEach(x => { %><tr><td class="small"><%= usDate(x.sent_at) %></td><td><strong><%= x.org_name %></strong></td><td class="small"><%= x.scope_title %><%= x.city ? ' · ' + x.city : '' %></td>
  <td class="small"><%= x.learners ? x.learners + ' learner(s) · ' : '' %><%= DELIVERY[x.delivery] || '' %><% if (x.message) { %><br><%= x.message %><% } %></td>
  <td class="small"><%= x.contact_name %><br><a href="mailto:<%= x.email %>"><%= x.email %></a><%= x.phone ? ' · ' + x.phone : '' %></td></tr><% }) %></table></div><% } %>
<%- include('../partials/app-end') %>
