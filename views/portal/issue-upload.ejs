<%- include('../partials/app-start') %>
<div class="page-head"><h1>Issuance Center</h1></div>
<%- include('_steps', { step: 0 }) %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form class="card" method="post" action="/portal/issue/upload" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="field"><label>Certificate template</label>
    <select name="template_id" required><% templates.forEach(t => { %><option value="<%= t.id %>"><%= t.name %> (<%= t.design %><%= t.validity_months ? ', valid ' + t.validity_months + ' months' : ', no expiry' %>)</option><% }) %></select>
    <div class="hint"><a href="/portal/templates">Manage templates</a></div></div>
  <div class="field"><label>Trainee data (CSV)</label><input type="file" name="csv" accept=".csv,text/csv" required>
    <div class="hint">Columns: first_name, last_name, email, course_name, completion_date (YYYY-MM-DD or MM/DD/YYYY), grade (optional). Max 5,000 rows / 5 MB. <a href="/sample.csv">Download sample CSV</a></div></div>
  <button class="btn">Upload &amp; continue →</button>
</form>
<%- include('../partials/app-end') %>
