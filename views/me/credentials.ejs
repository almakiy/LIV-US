<%- include('../partials/head') %>
<div class="container me-wrap">
  <h1>My credentials</h1>
  <%- include('_nav') %>
  <%- include('../partials/flash') %>
  <h2>In your account</h2>
  <% if (linked.length) { %><div class="table-wrap" tabindex="0"><table>
    <tr><th>Number</th><th>Course</th><th>Training provider</th><th>Issued</th><th>Status</th><th>Record</th><th></th></tr>
    <% linked.forEach(c => { %><%- include('_credential-row', { c }) %>
      <td><% if (c.pdf_t) { %><a href="/verify/<%= c.cert_number %>/pdf?t=<%= c.pdf_t %>">PDF</a> · <a href="/badges/credentials/<%= c.cert_number %>.json?t=<%= c.pdf_t %>">Badge</a><% } %></td>
      <td><form method="post" action="/me/credentials/<%= c.claim_id %>/release" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost" aria-label="Remove <%= c.cert_number %> from my account">Remove</button></form></td></tr><% }) %>
  </table></div><% } else { %><p class="muted">No credential is linked to your account yet.</p><% } %>

  <h2 class="mt">Found under your confirmed addresses</h2>
  <% if (!u.email_verified_at) { %><p class="muted">Confirm your email address first.</p>
  <% } else if (claimable.length) { %><div class="table-wrap" tabindex="0"><table>
    <tr><th>Number</th><th>Course</th><th>Training provider</th><th>Issued</th><th>Status</th><th></th></tr>
    <% claimable.forEach(c => { %><%- include('_credential-row', { c }) %>
      <td><form method="post" action="/me/credentials/claim" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="certificate_id" value="<%= c.id %>"><button class="btn sm" aria-label="Add <%= c.cert_number %> to my account">Add to my account</button></form></td></tr><% }) %>
  </table></div><% } else { %><p class="muted">Nothing new was found under your confirmed addresses.</p><% } %>

  <div class="grid g2 mt">
    <div class="card" id="emails"><h2 class="h3">Other addresses you used</h2>
      <p class="small muted">If a training provider recorded another of your email addresses, add and confirm it here. It is used only to find your credentials.</p>
      <% if (emails.length) { %><ul class="small"><% emails.forEach(e => { %><li><%= e.email %> — <%= e.verified_at ? 'confirmed' : 'waiting for confirmation' %>
        <form method="post" action="/me/emails/<%= e.id %>/remove" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Remove</button></form></li><% }) %></ul><% } %>
      <form method="post" action="/me/emails"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="x-email">Email address</label><input id="x-email" type="email" name="email" required></div><button class="btn sm">Send confirmation link</button></form></div>
    <div class="card" id="request"><h2 class="h3">Ask LIV to link a credential</h2>
      <p class="small muted">If you no longer use the address your training provider recorded, LIV staff can check your request. The number alone is not enough: explain why the credential is yours.</p>
      <form method="post" action="/me/credentials/request"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="q-num">Credential number</label><input id="q-num" name="cert_number" placeholder="LIV-2026-ABCD2345" maxlength="20" required></div>
        <div class="field"><label for="q-why">Why this credential is yours (in English)</label><textarea id="q-why" name="statement" rows="4" minlength="20" maxlength="2000" required></textarea></div>
        <button class="btn sm">Send request</button></form></div>
  </div>
  <% if (requests.length) { %><h2 class="mt">Your requests</h2><div class="table-wrap" tabindex="0"><table>
    <tr><th>Number</th><th>Sent</th><th>Status</th><th>LIV's reason</th><th></th></tr>
    <% requests.forEach(q => { %><tr><td><%= q.cert_number %></td><td><%= usDate(q.created_at) %></td><td><%= q.status %></td><td><%= q.decision_reason || '' %></td>
      <td><% if (q.status === 'submitted') { %><form method="post" action="/me/credentials/requests/<%= q.id %>/withdraw" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Withdraw</button></form><% } %></td></tr><% }) %>
  </table></div><% } %>
</div>
<%- include('../partials/foot') %>
