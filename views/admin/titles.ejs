<%- include('../partials/app-start') %>
<div class="page-head"><h1>Title requests</h1></div>
<p class="small muted">Titles providers ask to deliver for LIV credentials. The reviewer returns or recommends; a different person, the decision-maker, authorizes or refuses. Fees for title requests are not charged yet (pending approval).</p>
<% if (rows.length) { %><div class="table-wrap"><table><tr><th>Provider</th><th>Request</th><th>Type</th><th>Status</th><th>Revision</th><th>Updated</th><th></th></tr>
<% rows.forEach(t => { %><tr><td><%= t.company_name %></td><td><strong><%= t.title %></strong></td><td class="small"><%= t.kind === 'expansion' ? 'Scope expansion' : 'Title' %></td><td><span class="badge b-pending"><%= t.status.replace(/_/g, ' ') %></span></td><td><%= t.revision %></td><td class="small"><%= usDateTime(t.updated_at) %></td><td><a class="btn sm secondary" href="/admin/titles/<%= t.id %>">Open</a></td></tr><% }) %></table></div>
<% } else { %><p class="muted">No submitted requests.</p><% } %>
<%- include('../partials/app-end') %>
