<% if (p.accreditation_status !== 'active') { %><form method="post" action="/admin/platforms/<%= p.id %>/status" style="display:inline" data-confirm="Approve <%= p.company_name %>? They will be able to issue certificates."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="active"><button class="btn success sm"><%= p.accreditation_status === 'pending' ? 'Approve' : 'Reactivate' %></button></form><% } %>
<% if (p.accreditation_status === 'active') { %><form method="post" action="/admin/platforms/<%= p.id %>/status" style="display:inline" data-confirm="Suspend <%= p.company_name %>? Issuance stops immediately; existing certificates still verify but show the provider as suspended."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="suspended"><button class="btn danger sm">Suspend</button></form><% } %>
