<%- include('../../partials/app-start') %>
<div class="page-head"><h1>New controlled document</h1></div>
<form method="post" action="/admin/qms/documents" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <div class="row"><div class="field"><label>Document number *</label><input type="text" name="doc_no" required value="<%= f.doc_no || '' %>" placeholder="LIV-PRO-009"></div>
    <div class="field"><label>Type *</label><select name="doc_type"><% Object.entries(DOC_TYPES).forEach(([k, l]) => { %><option value="<%= k %>" <%= f.doc_type === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div></div>
  <div class="field"><label>Title *</label><input type="text" name="title" required maxlength="200" value="<%= f.title || '' %>"></div>
  <div class="row"><div class="field"><label>Owner</label><input type="text" name="owner_name" value="<%= f.owner_name || '' %>"></div>
    <div class="field"><label>Review every (months)</label><input type="number" name="review_months" min="1" max="60" value="<%= f.review_months || 12 %>"></div></div>
  <button class="btn">Create draft</button>
</form>
<%- include('../../partials/app-end') %>
