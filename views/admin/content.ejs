<%- include('../partials/app-start') %>
<div class="page-head"><h1>Knowledge hub content</h1><a class="btn" href="/admin/content/new">+ New article</a></div>
<% if (lib.total || lib.errors.length) { %><div class="card">
  <h2>Editorial library</h2>
  <p class="small muted">Prepared articles, guides, handbooks and research digests kept in the repository (content/library), with their sources. Loading adds them as <strong>drafts</strong> with an automated review report; nothing is published until a named reviewer checks each one against its sources and publishes it.</p>
  <p><%= lib.total %> item(s) in the library, <strong><%= lib.missing %></strong> not on the site yet.</p>
  <% if (lib.missing) { %><form method="post" action="/admin/content/library"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" type="submit">Load <%= lib.missing %> library draft(s)</button></form><% } %>
  <p class="small"><a href="/admin/content/library/review-packs.zip">Download expert review packs for all library items (ZIP of Excel files)</a></p>
  <% if (lib.errors.length) { %><div class="alert error"><strong>Library files with errors (not loaded):</strong><ul><% lib.errors.forEach(e => { %><li class="small"><%= e %></li><% }) %></ul></div><% } %>
</div><% } %>
<div class="table-wrap"><table>
  <tr><th>Title</th><th>Topic</th><th>Type</th><th>Status</th><th>Review</th><th>Updated</th><th></th></tr>
  <% if (!rows.length) { %><tr><td colspan="7" class="muted center">Nothing here yet. Write the first article.</td></tr><% } %>
  <% rows.forEach(a => { %><tr><td><a href="/admin/content/<%= a.id %>"><%= a.title %></a><div class="small muted">/knowledge/<%= a.slug %></div></td>
  <td><%= CATEGORIES[a.category] %></td><td><%= KINDS[a.kind] %></td>
  <td><span class="badge <%= a.status === 'published' ? 'b-active' : 'b-pending' %>"><%= a.status %></span></td>
  <td class="small"><%= a.reviewed_by ? a.reviewed_by : 'not reviewed' %><% if (a.origin === 'engine') { %> <span class="badge b-pending">engine</span><% } %><% if (a.origin === 'library') { %> <span class="badge b-pending">library</span><% } %><% if (a.stale) { %> <span class="badge b-suspended">review due</span><% } %></td>
  <td><%= usDate(a.updated_at) %></td>
  <td class="right"><% if (a.status === 'published') { %><a href="/knowledge/<%= a.slug %>" target="_blank" rel="noopener">View</a><% } %></td></tr><% }) %>
</table></div>
<%- include('../partials/app-end') %>
