<%- include('../partials/app-start') %>
<div class="page-head"><h1><%= a.id ? 'Edit article' : 'New article' %></h1>
  <% if (a.id) { %><span class="badge <%= a.status === 'published' ? 'b-active' : 'b-pending' %>"><%= a.status %></span><% } %></div>
<form method="post" action="/admin/content" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (a.id) { %><input type="hidden" name="id" value="<%= a.id %>"><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <div class="field"><label>Title *</label><input type="text" name="title" required maxlength="200" value="<%= a.title %>"></div>
  <div class="row">
    <div class="field"><label>Topic</label><select name="category"><% Object.entries(CATEGORIES).forEach(([k, l]) => { %><option value="<%= k %>" <%= a.category === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
    <div class="field"><label>Type</label><select name="kind"><% Object.entries(KINDS).forEach(([k, l]) => { %><option value="<%= k %>" <%= a.kind === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
  </div>
  <div class="field"><label>Summary * <span class="muted small">(shown in lists and search results, max 300 characters)</span></label><textarea name="summary" rows="2" maxlength="300"><%= a.summary %></textarea></div>
  <div class="field"><label>Body (Markdown) *</label><textarea name="body_md" rows="18" style="font-family:ui-monospace,Menlo,monospace"><%= a.body_md %></textarea>
    <div class="hint">Supports headings (##), lists, tables, links and quotes. Raw HTML, scripts and images are removed for safety.</div></div>
  <div class="row">
    <div class="field"><label>Author</label><input type="text" name="author_name" maxlength="150" value="<%= a.author_name %>"></div>
    <div class="field"><label>Tags (comma separated)</label><input type="text" name="tags" value="<%= (a.tags || []).join(', ') %>"></div>
  </div>
  <fieldset class="field" style="border:1px solid var(--line);border-radius:8px;padding:12px 14px">
    <legend class="small" style="padding:0 6px"><strong>Evidence and review</strong></legend>
    <div class="field"><label>Sources <span class="muted small">(one per line: Title | https://link | Publisher)</span></label>
      <textarea name="sources_text" rows="4" style="font-family:ui-monospace,Menlo,monospace"><%= sourcesText %></textarea>
      <div class="hint">Cite primary sources (regulators, standards bodies, peer-reviewed research). Lines without a valid http(s) link are ignored.</div></div>
    <div class="row">
      <div class="field"><label>Standards referenced <span class="muted small">(comma separated, with edition)</span></label><input type="text" name="standards" value="<%= (a.standards || []).join(', ') %>" placeholder="ISO 45001:2018, ISO 19011:2018"></div>
      <div class="field"><label>Jurisdiction <span class="muted small">(where the content applies, e.g. Saudi Arabia, GCC, International)</span></label><input type="text" name="jurisdiction" maxlength="80" value="<%= a.jurisdiction || '' %>"></div>
      <div class="field"><label>Next review due</label><input type="date" name="next_review_at" value="<%= a.next_review_at ? String(a.next_review_at.toISOString ? a.next_review_at.toISOString().slice(0, 10) : a.next_review_at).slice(0, 10) : '' %>"></div>
    </div>
    <div class="row">
      <div class="field"><label>Reviewed by <span class="muted small">(named human subject-matter reviewer; required to publish)</span></label><input type="text" name="reviewed_by" maxlength="150" value="<%= a.reviewed_by || '' %>"></div>
      <div class="field"><label>Change note <span class="muted small">(saved in the version history)</span></label><input type="text" name="change_note" maxlength="300"></div>
    </div>
    <% if (report && report.result === 'block') { %><div class="field"><label>Override reason <span class="muted small">(the automated review blocked this version; a reason is recorded if you publish anyway)</span></label><input type="text" name="override_reason" maxlength="300"></div><% } %>
    <label class="small"><input type="checkbox" name="ai_assisted" <%= a.ai_assisted ? 'checked' : '' %>> Prepared with AI assistance (shows a disclosure on the public page)</label>
    <% if (a.id) { %><p class="small muted mt">Version <%= a.version %><%= a.origin === 'engine' ? ' · created by an engine' : '' %><%= a.reviewed_at ? ' · reviewed ' + usDate(a.reviewed_at) : '' %>. If the text changes after review, re-enter the reviewer's name to confirm the sign-off still stands.</p><% } %>
  </fieldset>
  <div class="field"><label>URL slug <span class="muted small">(optional, generated from the title)</span></label><input type="text" name="slug" value="<%= a.slug %>"></div>
  <div class="actions">
    <button class="btn secondary" name="action" value="draft">Save draft</button>
    <button class="btn" name="action" value="publish"><%= a.status === 'published' ? 'Save & keep published' : 'Publish' %></button>
    <% if (a.status === 'published') { %><button class="btn secondary" name="action" value="unpublish">Unpublish</button><% } %>
    <button class="btn secondary" formaction="/admin/content/preview" formtarget="_blank">Preview</button>
  </div>
</form>
<% if (a.id) { %><div class="card mt"><h3>Automated review</h3>
  <% if (report) { %><p><span class="badge <%= report.result === 'pass' ? 'b-active' : report.result === 'block' ? 'b-suspended' : 'b-pending' %>"><%= report.result.replace('_', ' ') %></span> score <%= report.score %>/100 · <%= report.engine %> · <%= usDateTime(report.created_at) %><% if (report.model && report.model.provider) { %> · model: <%= report.model.provider %> <%= report.model.name %><% } %></p>
    <% if (report.flags.length) { %><table><tr><th>Level</th><th>Check</th><th>Finding</th></tr><% report.flags.forEach(f => { %><tr><td><span class="badge <%= f.severity === 'block' ? 'b-suspended' : 'b-pending' %>"><%= f.severity %></span></td><td class="small"><%= f.check %></td><td class="small"><%= f.message %><%= f.location ? ' (' + f.location + ')' : '' %></td></tr><% }) %></table><% } else { %><p class="small muted">No findings.</p><% } %>
  <% } else { %><p class="small muted">No automated review for version <%= a.version %> yet.</p><% } %>
  <p class="small muted">An automated review narrows what a human must check; it does not replace the named reviewer's sign-off.</p>
  <% if (a.status === 'draft') { %><form method="post" action="/admin/content/<%= a.id %>/request-review" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary sm"><%= a.review_requested_at ? 'Review requested (waiting for the engine)' : 'Request automated review' %></button></form><% } %>
</div><% } %>
<% if (versions && versions.length) { %><h3 class="mt">Version history</h3><div class="table-wrap"><table><tr><th>Version</th><th>By</th><th>Note</th><th>Date</th></tr>
  <% versions.forEach(v => { %><tr><td><%= v.version %></td><td><%= v.changed_by %></td><td><%= v.change_note %></td><td><%= usDate(v.created_at) %></td></tr><% }) %></table></div><% } %>
<% if (a.id) { %><form method="post" action="/admin/content/<%= a.id %>/delete" data-confirm="Delete this article permanently?" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger sm">Delete article</button></form><% } %>
<%- include('../partials/app-end') %>
