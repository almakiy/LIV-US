<%- include('../partials/app-start') %>
<div class="page-head"><h1>All credentials</h1><span class="muted"><%= n %> total</span></div>
<form class="row" method="get" style="margin-bottom:16px"><div><input type="search" name="q" value="<%= search %>" placeholder="Search ID, name, email or platform"></div><div style="flex:0"><button class="btn secondary">Search</button></div></form>
<div class="table-wrap"><table>
  <tr><th>Certificate ID</th><th>Trainee</th><th>Course</th><th>Platform</th><th>Issued</th><th>Status</th><th>Revoke</th></tr>
  <% if (!rows.length) { %><tr><td colspan="7" class="center muted">No certificates found.</td></tr><% } %>
  <% rows.forEach(c => { %><tr><td class="mono"><a href="<%= verifyLink(c) %>" target="_blank"><%= c.cert_number %></a></td>
  <td><%= c.recipient_first_name %> <%= c.recipient_last_name %></td><td><%= c.course_name %></td><td><%= c.company_name %></td><td><%= usDate(c.issue_date) %></td>
  <td><%- include('../partials/status', { c }) %></td>
  <td><% if (c.status === 'active') { %><form method="post" action="/admin/certificates/<%= c.cert_number %>/revoke" class="row" style="gap:6px;flex-wrap:nowrap" data-confirm="Revoke <%= c.cert_number %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="reason" placeholder="Reason" required minlength="5" style="min-width:120px"><button class="btn danger sm" style="flex:0">Revoke</button></form><% } else { %><span class="small muted"><%= c.revocation_reason || '' %></span><% } %></td></tr><% }) %>
</table></div>
<div class="pager"><% if (page > 1) { %><a class="btn secondary sm" href="?q=<%= encodeURIComponent(search) %>&page=<%= page-1 %>">← Prev</a><% } %><span class="muted small">Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a class="btn secondary sm" href="?q=<%= encodeURIComponent(search) %>&page=<%= page+1 %>">Next →</a><% } %></div>
<%- include('../partials/app-end') %>
