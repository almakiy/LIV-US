<%- include('../partials/app-start') %>
<div class="page-head"><h1><%= p.company_name %></h1><div><span class="badge b-<%= p.accreditation_status %>"><%= p.accreditation_status %></span> <%- include('_status_buttons', { p }) %>
  <form method="post" action="/admin/platforms/<%= p.id %>/act-as" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn gold">Act as partner (issue credentials)</button></form></div></div>
<div class="grid g2">
  <div class="card details"><dl>
    <dt>Website</dt><dd><%= p.website || '—' %></dd><dt>Country</dt><dd><%= p.country || '—' %></dd>
    <dt>Contact</dt><dd><%= p.contact_email || '—' %></dd><dt>Applied</dt><dd><%= usDateTime(p.created_at) %></dd>
    <dt>Certificates</dt><dd><%= st.total %> (<%= st.revoked %> revoked)</dd>
  </dl></div>
  <div class="table-wrap"><table><tr><th>User</th><th>Email</th><th>Last login</th><th>2FA</th><th></th></tr>
    <% users.forEach(u => { %><tr><td><%= u.full_name %></td><td><%= u.email %></td><td><%= u.last_login_at ? usDate(u.last_login_at) : 'Never' %></td>
      <td><span class="badge <%= u.totp_enabled ? 'b-active' : 'b-pending' %>"><%= u.totp_enabled ? 'on' : 'off' %></span></td>
      <td class="right small">
        <form method="post" action="/admin/users/<%= u.id %>/reset-password" style="display:inline" data-confirm="Reset the password for <%= u.email %>? A temporary password is shown once."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary sm">Reset password</button></form>
        <% if (u.totp_enabled) { %><form method="post" action="/admin/users/<%= u.id %>/reset-2fa" style="display:inline" data-confirm="Reset two-factor sign-in for <%= u.email %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary sm">Reset 2FA</button></form><% } %>
      </td></tr><% }) %></table></div>
</div>
<% if (newPassword) { %><div class="alert success"><strong>Temporary password (shown once, share it securely; the user must change it at first sign-in):</strong><div class="keybox mt"><%= newPassword %></div></div><% } %>
<div class="card mt details"><dl>
  <dt>Agreement</dt><dd><%= agr ? (agr.accepted_at ? 'v' + agr.version + ' accepted by ' + agr.accepted_name + ' on ' + usDate(agr.accepted_at) : 'v' + agr.version + ' not yet accepted') : 'No active agreement' %></dd>
  <dt>Billing</dt><dd><%= [p.billing_name, p.billing_email, p.tax_id && ('Tax ID ' + p.tax_id)].filter(Boolean).join(' · ') || 'Not provided' %></dd>
</dl></div>
<h2 class="mt" id="scope">Authorized scope</h2>
<p class="small muted">Courses or curricula this partner is authorized to deliver. A credential is linked to a scope when its course name matches the scope title exactly (case and spacing ignored). Active scopes are listed on the public register and on matching verification records.</p>
<% if (scopes.length) { %><div class="table-wrap"><table><tr><th>Title</th><th>Family</th><th>Status</th><th>From</th><th>Until</th><th>Basis</th><th></th></tr>
<% scopes.forEach(s => { %><tr><td><%= s.title %></td><td class="small"><%= s.scheme_name || '—' %></td><td><span class="badge b-<%= s.status === 'active' ? 'active' : 'suspended' %>"><%= SCOPE_STATUS[s.status] %></span></td><td class="small"><%= usDate(s.granted_on) %></td><td class="small"><%= s.ends_on ? usDate(s.ends_on) : '—' %></td><td class="small"><%= s.decision_note %></td>
<td><form method="post" action="/admin/scopes/<%= s.id %>/status" class="row" style="gap:6px"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><% Object.entries(SCOPE_STATUS).forEach(([k, l]) => { %><option value="<%= k %>" <%= s.status === k ? 'selected' : '' %>><%= l %></option><% }) %></select><input name="reason" placeholder="Reason" maxlength="500"><button class="btn sm secondary">Update</button></form></td></tr><% }) %></table></div>
<% } else { %><p class="muted">No authorized scope recorded yet.</p><% } %>
<form class="card mt" method="post" action="/admin/platforms/<%= p.id %>/scopes"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Add authorized scope</h3>
  <div class="row"><div class="field"><label>Course or curriculum title *</label><input name="title" maxlength="200" required placeholder="As it appears on completion reports"></div>
  <div class="field"><label>Credential family</label><select name="scheme_id"><option value="">None</option><% schemes.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div></div>
  <div class="row"><div class="field"><label>Authorized from</label><input type="date" name="granted_on"></div><div class="field"><label>Until (optional)</label><input type="date" name="ends_on"></div></div>
  <div class="field"><label>Basis for the decision *</label><input name="decision_note" maxlength="500" required placeholder="e.g. Review LIV-REV-2026-014, curriculum and trainer files approved"></div>
  <button class="btn">Add scope</button></form>
<h2 class="mt">Activity</h2>
<%- include('_audit_table', { rows: log.map(a => ({ ...a, company_name: p.company_name })) }) %>
<%- include('../partials/app-end') %>
