<%- include('../partials/app-start') %>
<div class="page-head"><h1>Trainer submissions</h1></div>
<% if (rows.length) { %><div class="table-wrap" tabindex="0"><table><tr><th>Provider</th><th>Trainer</th><th>Status</th><th>Updated</th><th></th></tr><% rows.forEach(t => { %><tr><td><%= t.company_name %></td><td><strong><%= t.trainer_name %></strong></td><td><span class="badge b-pending"><%= t.status.replace('_', ' ') %></span></td><td class="small"><%= usDateTime(t.updated_at) %></td><td><a class="btn sm secondary" href="/admin/trainers/<%= t.id %>">Open</a></td></tr><% }) %></table></div><% } else { %><p class="muted">No submissions.</p><% } %>
<%- include('../partials/app-end') %>
