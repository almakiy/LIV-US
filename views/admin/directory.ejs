<%- include('../partials/app-start') %>
<div class="page-head"><h1>Directory changes</h1></div>
<p class="small muted">Provider changes to the public directory are checked here before they are shown. Reviewing a profile change needs the Application Assessor position; deciding a branch and recording scope details needs the Authorization Decision-Maker position. Nothing is shown publicly until the decision is recorded.</p>

<h2>Profile changes waiting</h2>
<% if (d.profiles.length) { %><% d.profiles.forEach(r => { %><div class="card mt"><h3 style="margin-top:0"><%= r.company_name %> · sent <%= usDate(r.submitted_at) %></h3>
  <div class="table-wrap"><table><tr><th>Field</th><th>Published now</th><th>Proposed</th></tr>
  <% Object.keys(PROFILE).forEach(k => { const cur = r[k] ?? null; const next = r.fields[k] ?? null; %><tr class="<%= (cur || null) === next ? 'muted' : '' %>"><td class="small"><%= PROFILE[k].label %></td><td class="small"><%= cur || '—' %></td><td class="small"><%= next || '—' %></td></tr><% }) %>
  </table></div>
  <% if (can.assess) { %><form method="post" action="/admin/directory/profiles/<%= r.id %>/decide" class="row" style="gap:8px;margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label for="pn-<%= r.id %>" class="small">Reason *</label><input id="pn-<%= r.id %>" name="note" required maxlength="2000" style="flex:1">
    <button class="btn sm" name="outcome" value="approved">Approve and publish</button><button class="btn sm secondary" name="outcome" value="rejected">Reject</button></form><% } %>
</div><% }) %><% } else { %><p class="muted">No profile change is waiting.</p><% } %>

<h2 class="mt">Branch requests waiting</h2>
<% if (d.branches.length) { %><% d.branches.forEach(b => { %><div class="card mt"><h3 style="margin-top:0"><%= b.name %> · <%= b.company_name %></h3>
  <p class="small"><%= [b.address, b.city, b.country].filter(Boolean).join(', ') %></p>
  <% if (can.decide) { %><form method="post" action="/admin/directory/branches/<%= b.id %>/decide"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset><legend><strong>Scopes to approve for this branch</strong></legend>
    <% b.scopes.forEach(s => { %><div class="field"><input id="ap-<%= s.scope_id %>" type="checkbox" name="approve_<%= s.scope_id %>" <%= s.approved ? 'checked' : '' %>> <label for="ap-<%= s.scope_id %>"><%= s.scope_number ? s.scope_number + ' · ' : '' %><%= s.title %></label>
      <label for="me-<%= s.scope_id %>" class="small muted">Delivery methods (as approved)</label><input id="me-<%= s.scope_id %>" name="methods_<%= s.scope_id %>" maxlength="300" value="<%= s.delivery_methods || '' %>"></div><% }) %>
    </fieldset>
    <div class="field"><label for="bn-<%= b.id %>">Reason *</label><textarea id="bn-<%= b.id %>" name="note" rows="2" maxlength="2000" required></textarea></div>
    <button class="btn" name="outcome" value="approved">Approve the chosen scopes</button> <button class="btn secondary" name="outcome" value="refused">Refuse the branch</button>
  </form><% } else { %><p class="small muted">Waiting for the Authorization Decision-Maker.</p><% } %></div><% }) %><% } else { %><p class="muted">No branch request is waiting.</p><% } %>

<h2 class="mt">Scope details</h2>
<p class="small muted">Recorded by LIV. Each change raises the scope revision and is kept in the audit log with the before and after values.</p>
<% if (d.scopes.length) { %><% d.scopes.forEach(s => { %><details class="card mt"><summary><strong><%= s.company_name %></strong> · <%= s.title %> <span class="muted small">(revision <%= s.revision %>)</span></summary>
  <% if (can.decide) { %><form method="post" action="/admin/directory/scopes/<%= s.id %>" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><div class="field"><label for="sn-<%= s.id %>">Scope number</label><input id="sn-<%= s.id %>" name="scope_number" maxlength="30" value="<%= s.scope_number || '' %>"></div>
    <div class="field"><label for="sd-<%= s.id %>">Domain</label><input id="sd-<%= s.id %>" name="domain" maxlength="500" value="<%= s.domain || '' %>"></div></div>
    <div class="field"><label for="sb-<%= s.id %>">Boundaries</label><textarea id="sb-<%= s.id %>" name="boundaries" rows="2" maxlength="1000"><%= s.boundaries || '' %></textarea></div>
    <div class="field"><label for="sr-<%= s.id %>">Restrictions</label><textarea id="sr-<%= s.id %>" name="restrictions" rows="2" maxlength="1000"><%= s.restrictions || '' %></textarea></div>
    <div class="field"><label for="sm-<%= s.id %>">Delivery methods</label><input id="sm-<%= s.id %>" name="delivery_methods" maxlength="300" value="<%= s.delivery_methods || '' %>"></div>
    <button class="btn sm">Record the scope details</button></form>
  <% } else { %><p class="small muted">Only the Authorization Decision-Maker can record scope details.</p><% } %>
</details><% }) %><% } else { %><p class="muted">No active scope.</p><% } %>
<%- include('../partials/app-end') %>
