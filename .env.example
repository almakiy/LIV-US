# PostgreSQL connection
DATABASE_URL=postgres://liv:liv@localhost:5432/liv
# Long random strings (e.g. `openssl rand -hex 32`). REQUIRED in production.
SESSION_SECRET=
# Signs every certificate. NEVER change after go-live: existing certificates would fail verification. Back it up.
CERT_HMAC_SECRET=
# Public URL that QR codes point to (no trailing slash). Set before issuing real certificates.
BASE_URL=https://verify.example.com
PORT=3000
NODE_ENV=production
# Where PDFs and logos are stored (mount a persistent volume here)
STORAGE_DIR=./storage
BRAND_NAME=LIV
BRAND_LONG_NAME=Leading Institute of Verification
LEGAL_ENTITY=LIV LLC
# Initial super admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
