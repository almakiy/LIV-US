# PostgreSQL connection
DATABASE_URL=postgres://liv:liv@localhost:5432/liv
# Long random strings (e.g. `openssl rand -hex 32`). REQUIRED in production.
SESSION_SECRET=
# Signs every certificate. NEVER change after go-live: existing certificates would fail verification. Back it up.
CERT_HMAC_SECRET=
# Public URL that QR codes point to (no trailing slash). Set before issuing real certificates.
# Public base URL for canonical links, sitemap, RSS, QR codes and verification links (production: https://livcredentials.org).
# PUBLIC_BASE_URL takes precedence over BASE_URL.
PUBLIC_BASE_URL=https://livcredentials.org
BASE_URL=
PORT=3000
NODE_ENV=production
# Where PDFs and logos are stored (mount a persistent volume here)
STORAGE_DIR=./storage
# Set to true only when the public provider application gateway is ready (default: hidden, staff-only operation)
PUBLIC_APPLY=false
# Excel (.xlsx) uploads (temporary test feature). Set to false to accept CSV only.
ALLOW_XLSX=true
BRAND_NAME=LIV
BRAND_LONG_NAME=Leadership Institute of Validation
LEGAL_ENTITY=LIV LLC
# Initial super admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=
# Password of the demo provider created by `npm run seed` (default is for local use only)
SEED_DEMO_PASSWORD=

# Account security. REQUIRE_2FA: empty (optional), "admin" (LIV administrators must use an authenticator app) or "all".
REQUIRE_2FA=
# Optional separate key for encrypting authenticator secrets (defaults to a key derived from CERT_HMAC_SECRET, which must never change).
TOTP_ENCRYPTION_KEY=
# Quality records: let one person author and approve a document / verify their own action while the team is small. Set false when staff grows.
QMS_ALLOW_SELF_APPROVAL=true

# Billing: shown on invoices and in the partner portal. Use \n for new lines in BILLING_BANK_DETAILS.
BILLING_EMAIL=
LEGAL_ADDRESS=
BILLING_BANK_DETAILS=
# Publish the fee schedule at /fees only after you approve the fees.
PUBLIC_FEES=false
# Stripe: webhook signing secret (the endpoint answers 501 while empty) and the secret key that enables "Pay by card". Use test keys first. See docs/BILLING.md.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
